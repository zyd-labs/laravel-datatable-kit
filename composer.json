{
    "name": "zyd-labs/laravel-datatable-kit",
    "description": "Reusable DataTable utilities for Laravel projects.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "maatwebsite/excel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "ZydLabs\\LaravelDataTableKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZydLabs\\LaravelDataTableKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZydLabs\\LaravelDataTableKit\\Providers\\DataTableServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9",
        "phpunit/phpunit": "^11",
        "mockery/mockery": "^1.6"
    }
}
